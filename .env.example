# Database Configuration
MONGODB_URI=mongodb://localhost:27017/appchat

# JWT Security Credentials (Replace with strong random key in production)
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=900000

# Redis Cache & Messaging
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Upload Configuration
UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE=10MB

# Server & Ngrok Tunnel
SERVER_PORT=8080
NGROK_PUBLIC_URL=
